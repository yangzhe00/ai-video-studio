FROM python:3.13-slim@sha256:ae14d4ce8771606477a81446e7ef429edd6762305fc50c84507c1041fa8285d1
COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:c7db1d63057f268a8b6da8af9077850a60461f98d23db23c676a82089a050c91 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_PYTHON_DOWNLOADS=0 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
COPY apps/api-python/pyproject.toml apps/api-python/uv.lock /app/
RUN uv sync --frozen --no-dev --no-install-project
COPY apps/api-python/src /app/src
RUN uv sync --frozen --no-dev --no-editable && groupadd --system --gid 1000 avs && useradd --system --uid 1000 --gid 1000 avs
USER avs
EXPOSE 8787
HEALTHCHECK --interval=10s --timeout=3s --retries=6 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8787/health', timeout=2).read()" || exit 1
CMD ["uvicorn", "ai_video_api.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8787"]
