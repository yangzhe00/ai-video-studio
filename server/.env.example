# 复制为 .env 后按需修改；不配 Key 时全部自动回退 Mock，演示无需真实 Key
APP_ENV=demo
SECRET_KEY=dev-only-change-me
DATABASE_URL=postgresql+psycopg://taskify:taskify@localhost:5432/taskify

# LLM：Cursor Cloud Agents（选题/讲稿/分镜提示词，第一版 ai-video-studio 同源）
# Key 从 Cursor Dashboard > API Keys 获取；留空则 LLM 走 Mock 模板
LLM_PROVIDER=cursor
CURSOR_API_KEY=
CURSOR_BASE_URL=https://api.cursor.com/v1
# 留空 = 账号默认（Auto）；可选 id 见 GET /v1/models
CURSOR_MODEL=
CURSOR_TIMEOUT_SEC=180

# 视频生成：可灵（北京节点 kling-2.5-turbo，图生视频）
KLING_API_KEY=
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_MODEL=kling-2.5-turbo
KLING_RESOLUTION=720p

# 以下 Provider 当前仍为 Mock（预留接口，配 Key 即插拔）
TTS_PROVIDER=mock
VOLCENGINE_TTS_KEY=
SMS_PROVIDER=mock
TENCENT_SMS_KEY=
