# Server only. Export these values in the API process environment.
# The API does not automatically load .env.local; keep secrets out of client builds.
API_DATA_DIR=/private/tmp/ai-video-studio-data
DATABASE_URL=postgresql://localhost:5432/ai_video_studio
API_SESSION_SECRET=replace-with-at-least-32-random-characters
API_SECURE_COOKIES=false
API_ALLOWED_ORIGIN=http://127.0.0.1:1421
# Exact peer IPs of trusted reverse proxies only; Nginx must overwrite X-Real-IP.
API_TRUSTED_PROXY_IPS=
API_UPLOAD_TIMEOUT_MS=30000
API_MAX_CONCURRENT_UPLOADS=3
API_DEMO_QUOTA=3
API_MAX_TOTAL_DEMO_CREDITS=30
API_MAX_ACCOUNT_OBJECTS=100
API_MAX_ACCOUNT_STORAGE_BYTES=200000000
API_MAX_TOTAL_STORAGE_BYTES=2000000000
KLING_API_KEY=
# Use a TTS-capable key accepted by KLING_TTS_BASE_URL; keep the video key above unchanged.
KLING_TTS_API_KEY=
KLING_TTS_BASE_URL=https://api-singapore.klingai.com
# Required to enable TTS: JSON list [{"id":"...","label":"...","language":"zh"}]. Verify each ID with this account and region first; there is no default voice.
KLING_TTS_VOICES_JSON=
# Separate Agent edit feature; all three values are required when enabling it.
AGENT_EDIT_MODEL_BASE_URL=
AGENT_EDIT_MODEL_API_KEY=
AGENT_EDIT_MODEL_ID=
# Inspiration uses Cursor Cloud Agents only. Get this server-side key from Cursor Dashboard > API Keys.
CURSOR_API_KEY=
# Optional. Leave empty for the Cursor account default; use an id returned by GET /v1/models.
IDEA_CURSOR_MODEL=
IDEA_MODEL_TIMEOUT_MS=30000
IDEA_DAILY_LIMIT=20
IDEA_PLATFORM_DAILY_LIMIT=200
