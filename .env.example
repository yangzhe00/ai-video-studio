# Server only. Export these values in the API process environment.
# The API does not automatically load .env.local; keep secrets out of client builds.
API_DATA_DIR=/private/tmp/ai-video-studio-data
API_SESSION_SECRET=replace-with-at-least-32-random-characters
API_SECURE_COOKIES=false
API_ALLOWED_ORIGIN=http://127.0.0.1:1421
API_DEMO_QUOTA=3
API_MAX_TOTAL_DEMO_CREDITS=30
API_MAX_ACCOUNT_OBJECTS=100
API_MAX_ACCOUNT_STORAGE_BYTES=200000000
API_MAX_TOTAL_STORAGE_BYTES=2000000000
KLING_API_KEY=
IDEA_MODEL_BASE_URL=
IDEA_MODEL_API_KEY=
IDEA_MODEL_ID=
# Set IDEA_PROVIDER=agents for Codex Agents API, or cursor for Cursor Cloud Agents API.
# The chat provider remains the default when IDEA_PROVIDER is omitted.
IDEA_PROVIDER=chat
OPENAI_API_KEY=
IDEA_AGENT_MODEL=gpt-6-astra
# Server only. Get this key from Cursor Dashboard > API Keys, not from Cursor Settings > Models.
CURSOR_API_KEY=
# Optional. Leave empty for the Cursor account default; use an id returned by GET /v1/models.
IDEA_CURSOR_MODEL=
IDEA_MODEL_TIMEOUT_MS=30000
IDEA_DAILY_LIMIT=20
IDEA_PLATFORM_DAILY_LIMIT=200
