{
  "name": "ai-video-studio-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:desktop-ui": "pnpm --filter @ai-video/desktop dev",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter @ai-video/desktop preview",
    "tauri": "pnpm --filter @ai-video/desktop tauri",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test && node scripts/check-boundaries.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs"
  }
}
